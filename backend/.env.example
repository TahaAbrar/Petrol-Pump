# Copy to `.env` for local. On Render, set keys in the dashboard (never commit secrets).

USE_SQLITE=0

DEBUG=True
SECRET_KEY=change-me-in-production

# Comma-separated. On Render, RENDER_EXTERNAL_HOSTNAME is auto-added by settings.py
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database (pick ONE style) ---
# A) Neon / Render style (recommended on production):
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# B) Discrete vars (local Postgres or Neon without URL):
POSTGRES_DB=petrolpump
POSTGRES_USER=petrolpump
POSTGRES_PASSWORD=petrolpump
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSL=1
# POSTGRES_SSLMODE=require

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# After you have real domain OR pages.dev URL:
# CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com,https://YOUR.pages.dev
# CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com,https://api.yourdomain.com
# ALLOWED_HOSTS=api.yourdomain.com,.onrender.com
CSRF_TRUSTED_ORIGINS=

SERVE_MEDIA=True

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@totalstation.com
