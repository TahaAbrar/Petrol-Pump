[Unit]
Description=Sukka Petrol Frontend (Nitro Node SSR)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/suka-petrol/Petrol-Pump
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=NITRO_HOST=127.0.0.1
Environment=NITRO_PORT=8080
ExecStart=/usr/bin/node /root/suka-petrol/Petrol-Pump/.output/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
